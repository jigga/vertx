{
  "httpServerOptions": {
    "clientAuth": "REQUIRED",
    "ssl": true,
    "maxChunkSize": 262144,
    "sendBufferSize": 65536,
    "keyStoreOptions": {
      "alias": "server",
      "password": "password",
      "path": "server-keystore.jks"
    },
    "openSslEngineOptions": {
      "sessionCacheEnabled": true,
      "useWorkerThread": false
    },
    "trustStoreOptions": {
      "alias": "client-cert",
      "password": "password",
      "path": "server-truststore.jks"
    }
  }
}
